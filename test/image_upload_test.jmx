<?xml version='1.0' encoding='UTF-8'?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Image Upload Test"
      enabled="true">
      <stringProp name="TestPlan.comments"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments" />
      </elementProp>
      <stringProp name="TestPlan.serialize_threadgroups">false</stringProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Main Thread Group"
        enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
      </ThreadGroup>
      <hashTree>
        <!-- Step 1: Get SAS Token -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
          testname="Get SAS Token" enabled="true">
          <stringProp name="HTTPSampler.domain">wydbackend.azurewebsites.net</stringProp>
          <stringProp name="HTTPSampler.port"></stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">/api/Images/GetToken/68546c51b624d15b8c32a9cc</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor"
            testname="Construct blobNames" enabled="true">
            <stringProp name="script">def json = new
              groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())

              // Find both JPG and PNG images
              def jpgImage = json.images.find { it.extension == 'jpg' }
              def pngImage = json.images.find { it.extension == 'png' }

              // Store common SAS token
              vars.put('sasToken', json.sasToken)

              // Store JPG variables if exists
              if (jpgImage) {
              vars.put('jpg_eventId', jpgImage.eventId)
              vars.put('jpg_id', jpgImage.id)
              vars.put('jpg_extension', jpgImage.extension)
              vars.put('jpg_blobName', "${jpgImage.eventId}/${jpgImage.id}/${jpgImage.extension}")
              }

              // Store PNG variables if exists
              if (pngImage) {
              vars.put('png_eventId', pngImage.eventId)
              vars.put('png_id', pngImage.id)
              vars.put('png_extension', pngImage.extension)
              vars.put('png_blobName', "${pngImage.eventId}/${pngImage.id}/${pngImage.extension}")
              }</stringProp>
          </JSR223PostProcessor>
          <hashTree />
        </hashTree>

        <!-- Step 2: Upload JPG Image (if exists) -->
        <IfController guiclass="IfControllerGui" testclass="IfController" testname="If JPG Exists"
          enabled="true">
          <stringProp name="IfController.condition">vars.get("jpg_blobName") != null</stringProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
            testname="Upload JPG Image" enabled="true">
            <stringProp name="HTTPSampler.domain">wydmediastorage.blob.core.windows.net</stringProp>
            <stringProp name="HTTPSampler.port"></stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/images/${jpg_blobName}?${sasToken}</stringProp>
            <stringProp name="HTTPSampler.method">PUT</stringProp>
            <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
              <collectionProp name="HTTPFileArgs.files">
                <elementProp name="file" elementType="HTTPFileArg">
                  <stringProp name="File.path">test.jpg</stringProp>
                  <stringProp name="File.paramname"></stringProp>
                  <stringProp name="File.mimetype">image/jpeg</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor"
              testname="Set JPG Headers" enabled="true">
              <stringProp name="script">// Set required Azure headers
                sampler.getHeaderManager().removeHeaderNamed("x-ms-blob-type");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "x-ms-blob-type", "BlockBlob"
                ));

                sampler.getHeaderManager().removeHeaderNamed("x-ms-version");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "x-ms-version", "2025-01-05"
                ));

                // Get actual file size
                def file = new File("test.jpg");
                def fileSize = file.length();

                // Set content headers
                sampler.getHeaderManager().removeHeaderNamed("Content-Type");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "Content-Type", "image/jpeg"
                ));

                sampler.getHeaderManager().removeHeaderNamed("Content-Length");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "Content-Length", String.valueOf(fileSize)
                ));</stringProp>
            </JSR223PreProcessor>
          </hashTree>
        </hashTree>

        <!-- Step 3: Upload PNG Image (if exists) -->
        <IfController guiclass="IfControllerGui" testclass="IfController" testname="If PNG Exists"
          enabled="true">
          <stringProp name="IfController.condition">vars.get("png_blobName") != null</stringProp>
        </IfController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
            testname="Upload PNG Image" enabled="true">
            <stringProp name="HTTPSampler.domain">wydmediastorage.blob.core.windows.net</stringProp>
            <stringProp name="HTTPSampler.port"></stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/images/${png_blobName}?${sasToken}</stringProp>
            <stringProp name="HTTPSampler.method">PUT</stringProp>
            <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
              <collectionProp name="HTTPFileArgs.files">
                <elementProp name="file" elementType="HTTPFileArg">
                  <stringProp name="File.path">test.png</stringProp>
                  <stringProp name="File.paramname"></stringProp>
                  <stringProp name="File.mimetype">image/png</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor"
              testname="Set PNG Headers" enabled="true">
              <stringProp name="script">// Set required Azure headers
                sampler.getHeaderManager().removeHeaderNamed("x-ms-blob-type");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "x-ms-blob-type", "BlockBlob"
                ));

                sampler.getHeaderManager().removeHeaderNamed("x-ms-version");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "x-ms-version", "2025-01-05"
                ));

                // Get actual file size
                def file = new File("test.png");
                def fileSize = file.length();

                // Set content headers
                sampler.getHeaderManager().removeHeaderNamed("Content-Type");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "Content-Type", "image/png"
                ));

                sampler.getHeaderManager().removeHeaderNamed("Content-Length");
                sampler.getHeaderManager().add(new org.apache.jmeter.protocol.http.control.Header(
                "Content-Length", String.valueOf(fileSize)
                ));</stringProp>
            </JSR223PreProcessor>
          </hashTree>
        </hashTree>
        <hashTree />
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>